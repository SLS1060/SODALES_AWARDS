COLUMN TABLE "SDL_M_MSTDT" (
  MSTDT BIGINT PRIMARY KEY GENERATED ALWAYS AS IDENTITY (START WITH 1 INCREMENT BY 1) COMMENT 'Master Data ID',
  COLID INTEGER COMMENT 'Column ID Sequence',
  UNQID INTEGER UNIQUE COMMENT 'Unique ID (SEQ)',
  TYVAL NVARCHAR(100) COMMENT 'Type Value',
  TXVAL NVARCHAR(1000) COMMENT 'Text Value',
  ISDEL NVARCHAR(1) COMMENT 'Is Deleted Flag (1=True/0=False)',
  CRTBY NVARCHAR(50) COMMENT 'Created By',
  CRTDT DATE COMMENT 'Created Date',
  CRTTM TIME COMMENT 'Created Time',
  CHNBY NVARCHAR(50) COMMENT 'Changed By',
  CHNDT DATE COMMENT 'Changed Date',
  CHNTM TIME COMMENT 'Changed Time'
);
