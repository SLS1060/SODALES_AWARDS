COLUMN TABLE SDL_M_ASEKY (
  RLPID INTEGER PRIMARY KEY GENERATED ALWAYS AS IDENTITY (START WITH 1 INCREMENT BY 1) COMMENT 'Unique Id',
  ASEKY NVARCHAR(100) COMMENT 'key',
  ISDEL NVARCHAR(1) COMMENT 'Is deleted',
  CRTBY NVARCHAR(100) COMMENT 'Created By',
  CRTDT DATE COMMENT 'Created Date',
  CRTTM TIME COMMENT 'Created Time'
);