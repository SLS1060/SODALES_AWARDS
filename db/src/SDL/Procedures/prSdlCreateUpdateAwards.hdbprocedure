/* Functionality                : To create and update Attachments                                  */
/****************************************************************************************************/


PROCEDURE "prSdlCreateUpdateAwards"( 
    IN  AWRID  BIGINT,            -- Award ID
    IN  AWARD  INTEGER,           -- Award (Dropdown)
    IN  ACMNT  INTEGER,           -- Achivement (Dropdown)
    IN  CATEG  INTEGER,           -- Award Category
    IN  CNAME  NVARCHAR(500),     -- Certification Name
    IN  NOTES  NVARCHAR(5000),    -- Notes
    IN  STATS  INTEGER,      -- Status
    IN  STATS_TXT NVARCHAR(250),
    IN  REPBY  NVARCHAR(50),      -- Reported By
    IN  RBYNM  NVARCHAR(250),      -- Reported By name
    IN  REPDT  DATE,              -- Reported Date
    IN  AWRDT  DATE,              -- Award Date
    OUT OAWRID BIGINT             -- Output Parameter
)
   LANGUAGE SQLSCRIPT
   SQL SECURITY INVOKER
AS
BEGIN

    DECLARE COLUMN_ID INTEGER;
    DECLARE QU NVARCHAR(150); 
    DECLARE SEQ NVARCHAR(100); 

    IF :AWRID = 0 THEN 
        INSERT INTO SDL_T_AWRDS(AWARD, ACMNT, CATEG, CNAME, NOTES, STATS, STATS_TXT,REPBY, RBYNM,REPDT, AWRDT, ISDEL, CRTBY, CRTDT, CRTTM, CHNBY, CHNDT, CHNTM)
                         VALUES (AWARD, ACMNT, CATEG, CNAME, NOTES, STATS, STATS_TXT,REPBY, RBYNM,REPDT, AWRDT, '0', SESSION_CONTEXT('APPLICATIONUSER'), CURRENT_DATE, CURRENT_TIME, SESSION_CONTEXT('APPLICATIONUSER'), CURRENT_DATE, CURRENT_TIME);

                         
        SELECT '_SYS_SEQUENCE_'|| COLUMN_ID||'_#0_#' INTO SEQ FROM TABLE_COLUMNS WHERE (TABLE_NAME='SDL_T_AWRDS' ) AND COLUMN_NAME='AWRID';
        QU :='select '||SEQ||'.CURRVAL from DUMMY';
        EXECUTE IMMEDIATE QU INTO OAWRID;  

-- Update Data into tables
    ELSE
        UPDATE SDL_T_AWRDS
        SET AWARD=:AWARD, ACMNT=:ACMNT, CATEG=:CATEG, CNAME=:CNAME, NOTES=:NOTES, STATS=:STATS,STATS_TXT =:STATS_TXT,
            REPBY=:REPBY, RBYNM=:RBYNM, REPDT=:REPDT, AWRDT=:AWRDT, CHNBY=SESSION_CONTEXT('APPLICATIONUSER'),
            CHNDT=CURRENT_DATE, CHNTM=CURRENT_TIME
        WHERE AWRID=:AWRID AND ISDEL='0';

        OAWRID:=:AWRID;
    
END IF;
END