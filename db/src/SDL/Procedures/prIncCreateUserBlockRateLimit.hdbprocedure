/* Procedure Name 				: prIncCreateUserBlockRateLimit.hdbprocedure	           		 */
/* Functionality                : for Rate limit                                                 */
/*************************************************************************************************/
PROCEDURE prIncCreateUserBlockRateLimit(
    IN USRID NVARCHAR(50)  -- User ID
 )
   LANGUAGE SQLSCRIPT
   SQL SECURITY INVOKER
 AS
BEGIN
DECLARE CNT INTEGER;
 
    SELECT COUNT(USRID) INTO CNT FROM  SDL_T_USBLK WHERE USRID=:USRID AND ISDEL = 0;
 
    IF  CNT = 0  THEN
       
        INSERT INTO SDL_T_USBLK (USRID, BLKFG, ISDEL, CRTBY, CRTDT, CRTTM) VALUES (USRID,'1','0',SESSION_CONTEXT('APPLICATIONUSER'),CURRENT_DATE,CURRENT_TIME);
 
    -- ELSE
 
    --     UPDATE INC_T_USBLK
    --     SET BLKFG = '1',CHNBY=SESSION_CONTEXT('APPLICATIONUSER'),CHNDT=CURRENT_DATE,CHNTM=CURRENT_TIME
    --     WHERE LOWER(USRID) = LOWER(:USRID);
    END IF;
END