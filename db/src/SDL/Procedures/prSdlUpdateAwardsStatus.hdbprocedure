PROCEDURE prSdlUpdateAwardsStatus ( 
    IN  AWRID  BIGINT,            -- Award ID
    IN  STATS  INTEGER,           -- flag
    IN  STATS_TXT  NVARCHAR(1000)           -- flag
)
   LANGUAGE SQLSCRIPT
   SQL SECURITY INVOKER
AS
BEGIN
        UPDATE SDL_T_AWRDS
        SET STATS=:STATS,STATS_TXT =:STATS_TXT,
            CHNBY=SESSION_CONTEXT('APPLICATIONUSER'),
            CHNDT=CURRENT_DATE, CHNTM=CURRENT_TIME
        WHERE AWRID=:AWRID AND ISDEL='0';
 
END