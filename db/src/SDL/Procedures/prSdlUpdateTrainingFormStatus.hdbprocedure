/* Application Name         : Add Training Form                                                        */
/* Procedure Name 				  : prSdlUpdateTrainingFormStatus.hdbprocedure			                    */
/* Functionality            : To create and update Training Form                              */
/****************************************************************************************************/

PROCEDURE prSdlUpdateTrainingFormStatus(
    IN TRAID BIGINT,
    IN STATS SMALLINT,
    IN STATS_TXT NVARCHAR(20)
 )
   LANGUAGE SQLSCRIPT
   SQL SECURITY INVOKER
 AS
BEGIN
    UPDATE SDL_T_TRAPP
    SET STATS = :STATS, STATS_TXT = :STATS_TXT, CHNBY=SESSION_CONTEXT('APPLICATIONUSER'),
    CHNDT = CURRENT_DATE, CHNTM = CURRENT_TIME
    WHERE TRAID=:TRAID AND ISDEL ='0';
END