PROCEDURE "prSdlDeleteAttachments"( 
    IN  AWRID BIGINT,
    IN  ATHID BIGINT
)
   LANGUAGE SQLSCRIPT
   SQL SECURITY INVOKER

 AS
BEGIN

    UPDATE SDL_T_ATACH 
    SET ISDEL='1', CHNBY= SESSION_CONTEXT('APPLICATIONUSER'), CHNDT=CURRENT_DATE, CHNTM=CURRENT_TIME
    WHERE AWRID=:AWRID AND ATHID=:ATHID AND ISDEL='0'; 
END