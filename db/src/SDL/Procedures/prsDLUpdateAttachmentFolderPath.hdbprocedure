PROCEDURE prsDLUpdateAttachmentFolderPath( 
    IN  AWRID BIGINT,
    IN  ATPTH NVARCHAR(500)
)
   LANGUAGE SQLSCRIPT
   SQL SECURITY INVOKER

 AS
BEGIN

    UPDATE SDL_T_AWRDS 
    SET ATPTH=:ATPTH, CHNBY= SESSION_CONTEXT('APPLICATIONUSER'), CHNDT=CURRENT_DATE, CHNTM=CURRENT_TIME
    WHERE AWRID=:AWRID AND ISDEL='0'; 
END