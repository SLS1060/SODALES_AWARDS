PROCEDURE prSdlCreateUpdateTrainingForm(
    IN TRAID BIGINT,
    IN TDATE DATE,
    IN TTYPE SMALLINT,
    IN TOPIC NVARCHAR(250),
    IN TROLE SMALLINT,
    IN WILRN NVARCHAR(1000),
    IN TNAME NVARCHAR(250),
    OUT OTRAID INTEGER
  ) 
  LANGUAGE SQLSCRIPT 
  SQL SECURITY INVOKER AS 
BEGIN 
     DECLARE COLUMN_ID INTEGER;
    DECLARE QU NVARCHAR(150); 
    DECLARE SEQ NVARCHAR(100);

    IF :TRAID=0 THEN
  INSERT INTO SDL_T_TRAPP(
      USRID,
      TDATE,
      TTYPE,
      TOPIC,
      TROLE,
      WILRN,
      TNAME,
      ISDEL,
      CRTBY,
      CRTDT,
      CRTTM,
      CHNBY,
      CHNDT,
      CHNTM
    )
  VALUES(
      SESSION_CONTEXT('APPLICATIONUSER'),
      TDATE,
      TTYPE,
      TOPIC,
      TROLE,
      WILRN,
      TNAME,
      '0',
      SESSION_CONTEXT('APPLICATION_CONTEXT'),
      CURRENT_DATE,
      CURRENT_TIME,
      SESSION_CONTEXT('APPLICATION_CONTEXT'),
      CURRENT_DATE,
      CURRENT_TIME
    );


            SELECT '_SYS_SEQUENCE_'|| COLUMN_ID||'_#0_#' INTO SEQ FROM TABLE_COLUMNS WHERE (TABLE_NAME='SDL_T_TRAPP' ) AND COLUMN_NAME='TRAID';
        QU :='select '||SEQ||'.CURRVAL from DUMMY';
        EXECUTE IMMEDIATE QU INTO OTRAID;

  ELSE
  UPDATE SDL_T_TRAPP
  SET USRID = SESSION_CONTEXT('APPLICATIONUSER'),
    TDATE = :TDATE,
    TTYPE = :TTYPE,
    TOPIC = :TOPIC,
    TROLE = :TROLE,
    WILRN = :WILRN,
    TNAME = :TNAME,
    CHNBY = SESSION_CONTEXT('APPLICATIONUSER'),
    CHNDT = CURRENT_DATE,
    CHNTM = CURRENT_TIME
  WHERE ISDEL = '0'
    AND TRAID = :TRAID;

    OTRAID:=:TRAID;
END IF;
END