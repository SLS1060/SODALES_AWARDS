COLUMN TABLE SDL_T_TRAPP (
    TRAID BIGINT PRIMARY KEY GENERATED ALWAYS AS IDENTITY (START WITH 1 INCREMENT BY 1) COMMENT 'Unique Id',
    USRID NVARCHAR(30) COMMENT 'Employee ID',
    TDATE DATE COMMENT 'Date of Training',
    TTYPE SMALLINT COMMENT 'Type of training',
    TOPIC NVARCHAR(250) COMMENT 'Training Topic',
    TROLE SMALLINT COMMENT 'Training taken / participated',
    WILRN NVARCHAR(1000) COMMENT 'What I learnt (Description)',
    TNAME NVARCHAR(250) COMMENT 'Trainer Name',
    STATS SMALLINT COMMENT 'STATUS Unqid',
    STATS_TXT NVARCHAR(20) COMMENT 'Status Text',
    ISDEL NVARCHAR(1) COMMENT 'Is Deleted Flag(0/1)',
    CRTBY NVARCHAR(250) COMMENT 'Created By',
    CRTDT DATE COMMENT 'Created Date',
    CRTTM TIME COMMENT 'Created Time',
    CHNBY NVARCHAR(250) COMMENT 'Changed By',
    CHNDT DATE COMMENT 'Changed Date',
    CHNTM TIME COMMENT 'Changed Time'
)