COLUMN TABLE SDL_T_USBLK (
    BLKID INTEGER GENERATED ALWAYS AS IDENTITY (START WITH 1 INCREMENT BY 1) COMMENT 'Unique Id',
    USRID NVARCHAR(250) COMMENT 'User id session user',
    BLKFG NVARCHAR(1) COMMENT '1 if user is blocked',
    ISDEL NVARCHAR(1) COMMENT 'Delete',
    CRTBY NVARCHAR(100) COMMENT 'Created by',
    CRTDT DATE COMMENT 'Created date',
    CRTTM TIME COMMENT 'Created time',
    CHNBY NVARCHAR(100) COMMENT 'Changed by',
    CHNDT DATE COMMENT 'Changed date',
    CHNTM TIME COMMENT 'Changed time'
)