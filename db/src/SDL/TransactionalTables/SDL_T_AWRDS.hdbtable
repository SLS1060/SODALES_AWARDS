COLUMN TABLE "SDL_T_AWRDS" (
  AWRID BIGINT PRIMARY KEY GENERATED ALWAYS AS IDENTITY (START WITH 1 INCREMENT BY 1) COMMENT 'Award ID - Primary Key',
  AWARD INTEGER COMMENT 'AWARD',
  ACMNT INTEGER COMMENT 'Achivement (Dropdown)',
  CATEG INTEGER COMMENT 'Award Category',
  CNAME NVARCHAR(1000) COMMENT 'Certification Name',
  NOTES NVARCHAR(5000) COMMENT 'Notes',
  STATS INTEGER COMMENT 'Status',
  STATS_TXT NVARCHAR(250) COMMENT 'Status text',
  REPBY NVARCHAR(50) COMMENT 'Reported By',
  RBYNM NVARCHAR(250) COMMENT 'Reported By Name',
  REPDT DATE COMMENT 'Reported Date',
  AWRDT DATE COMMENT 'Award Date',
  ATPTH NVARCHAR(500) COMMENT 'attachment folder path',
  ISDEL NVARCHAR(1) COMMENT 'Is Deleted Flag (1=True/0=False)',
  CRTBY NVARCHAR(50) COMMENT 'Created By',
  CRTDT DATE COMMENT 'Created Date',
  CRTTM TIME COMMENT 'Created Time',
  CHNBY NVARCHAR(50) COMMENT 'Changed By',
  CHNDT DATE COMMENT 'Changed Date',
  CHNTM TIME COMMENT 'Changed Time'
);
