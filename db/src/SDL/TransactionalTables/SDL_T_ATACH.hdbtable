COLUMN TABLE "SDL_T_ATACH" (
  ATHID BIGINT PRIMARY KEY GENERATED ALWAYS AS IDENTITY (START WITH 1 INCREMENT BY 1) COMMENT 'Attachment Id - Primary Key',
  AWRID INTEGER COMMENT 'Award Id',
  ATTNM NVARCHAR(250) COMMENT 'Attachment Name',
  TITLE NVARCHAR(250) COMMENT 'Document Title',
  OBJID NVARCHAR(50) COMMENT 'Object ID',
  URLDT NVARCHAR(500) COMMENT 'URL',
  ISDEL NVARCHAR(1) COMMENT 'Is Deleted Flag (1=True/0=False)',
  CRTBY NVARCHAR(50) COMMENT 'Created By',
  CRTDT DATE COMMENT 'Created Date',
  CRTTM TIME COMMENT 'Created Time',
  CHNBY NVARCHAR(50) COMMENT 'Changed By',
  CHNDT DATE COMMENT 'Changed Date',
  CHNTM TIME COMMENT 'Changed Time'
);
